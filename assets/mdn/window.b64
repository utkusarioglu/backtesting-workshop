docs/Web/API/Window/copy_event\\\"><code>copy</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/cut_event\\\"><code>cut</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/devicemotion_event\\\"><code>devicemotion</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientation_event\\\"><code>deviceorientation</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientationabsolute_event\\\"><code>deviceorientationabsolute</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/error_event\\\"><code>error</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/focus_event\\\"><code>focus</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepadconnected_event\\\"><code>gamepadconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>moveTo()</code></strong> method of the <a href=\\\"/en-US/docs/Web/API/Window\\\"><code>Window</code></a>\\n  interface moves the current window to the specified coordinates.\\n</p>\\n<div class=\\\"notecard note\\\" id=\\\"sect1\\\">\\n  <p>\\n    <strong>Note:</strong> This function moves the window to an absolute location. In\\n    contrast, <a href=\\\"/en-US/docs/Web/API/Window/moveBy\\\"><code>window.moveBy()</code></a> moves the window relative to its current\\n    location.\\n  </p>\\n</div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"syntax\",\"title\":\"Syntax\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"Qg7YX4uCN0amZpowhy2JGTYpFJSme9xchKKNFCkKpLo=\\\"><code><span class=\\\"token function\\\">moveTo</span><span class=\\\"token punctuation\\\">(</span>x<span class=\\\"token punctuation\\\">,</span> y<span class=\\\"token punctuation\\\">)</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"parameters\",\"title\":\"Parameters\",\"isH3\":true,\"content\":\"<ul>\\n  <li><code>x</code> is the horizontal coordinate to be moved to.</li>\\n  <li><code>y</code> is the vertical coordinate to be moved to.</li>\\n</ul>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"return_value\",\"title\":\"Return value\",\"isH3\":true,\"content\":\"<p>None (<a href=\\\"/en-US/docs/Web/JavaScript/Reference/Global_Objects/undefined\\\"><code>undefined</code></a>).</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<p>This example moves the window to the top-left corner of the screen.</p>\\n<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"zvks/AuElJSPkmGp4UZBOx0CHWHvW/R7BPxNACLcydg=\\\"><code><span class=\\\"token keyword\\\">function</span> <span class=\\\"token function\\\">origin</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n  window<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">moveTo</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token number\\\">0</span><span class=\\\"token punctuation\\\">,</span> <span class=\\\"token number\\\">0</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n<span class=\\\"token punctuation\\\">}</span>\\n</code></pre></div>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://drafts.csswg.org/cssom-view/#dom-window-moveto\",\"title\":\"CSSOM View Module\"}],\"query\":\"api.Window.moveTo\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.moveTo\"}},{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>As of Firefox 7, websites can no longer move a browser window <a href=\\\"https://bugzil.la/565541#c24\\\" class=\\\"external\\\" target=\\\"_blank\\\">in the following cases</a>:</p>\\n<ol>\\n  <li>You can't move a window or tab that wasn't created by <a href=\\\"/en-US/docs/Web/API/Window/open\\\"><code>Window.open()</code></a>.</li>\\n  <li>You can't move a window or tab when it's in a window with more than one tab.</li>\\n</ol>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/moveBy\\\"><code>Window.moveBy()</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Syntax\",\"id\":\"syntax\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The moveTo() method of the Window\\n  interface moves the current window to the specified coordinates.\",\"popularity\":0.0045,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"ja\",\"title\":\"Window.moveTo()\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ru\",\"title\":\"Window.moveTo()\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"window.moveTo\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/moveto\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/moveto/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"moveTo()\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/moveTo\",\"title\":\"moveTo()\"}],\"pageTitle\":\"Window: moveTo() method - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance methods", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/open", "link_title": "open()", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.6803c6f0.png\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link rel=\"manifest\" href=\"/manifest.56b1cedc.json\"/><link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"/opensearch.xml\" title=\"MDN Web Docs\"/><title>Window: open() method - Web APIs | MDN</title><link rel=\"alternate\" title=\"Window.open()\" href=\"https://developer.mozilla.org/es/docs/Web/API/Window/open\" hreflang=\"es\"/><link rel=\"alternate\" title=\"Window.open()\" href=\"https://developer.mozilla.org/fr/docs/Web/API/Window/open\" hreflang=\"fr\"/><link rel=\"alternate\" title=\"Window: open() \u00e3\u0083\u00a1\u00e3\u0082\u00bd\u00e3\u0083\u0083\u00e3\u0083\u0089\" h