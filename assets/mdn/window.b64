API/Window/gamepadconnected_event\\\"><code>gamepadconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<div class=\\\"notecard nonstandard\\\" id=\\\"sect1\\\"><p><strong>Non-standard:</strong> This feature is non-standard and is not on a standards track. Do not use it on production sites facing the Web: it will not work for every user. There may also be large incompatibilities between implementations and the behavior may change in the future.</p></div>\\n<p>\\n  The <code>mozInnerScreenY</code> property of the <a href=\\\"/en-US/docs/Web/API/Window\\\"><code>Window</code></a> interface returns the Y coordinate of the top-left corner of the window's viewport, in screen\\n  coordinates.\\n</p>\\n<div class=\\\"notecard note\\\" id=\\\"sect2\\\">\\n  <p><strong>Note:</strong> This coordinate is reported in CSS pixels, not in hardware pixels.</p>\\n</div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"value\",\"title\":\"Value\",\"isH3\":false,\"content\":\"<p>The <code>window.mozInnerScreenY</code> property is a floating point, read-only value; it has no default value.</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"specifications\",\"title\":\"Specifications\",\"isH3\":false,\"content\":\"<p>This feature is not part of any current specification. It is not on track to become a standard.</p>\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.mozInnerScreenY\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/mozInnerScreenX\\\"><code>window.mozInnerScreenX</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Value\",\"id\":\"value\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The mozInnerScreenY property of the Window interface returns the Y coordinate of the top-left corner of the window's viewport, in screen\\n  coordinates.\",\"popularity\":0,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"fr\",\"title\":\"Window.mozInnerScreenY\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"Window.mozInnerScreenY\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"zh-CN\",\"title\":\"Window.mozInnerScreenY\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/mozinnerscreeny\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/mozinnerscreeny/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"mozInnerScreenY\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/mozInnerScreenY\",\"title\":\"mozInnerScreenY\"}],\"pageTitle\":\"Window: mozInnerScreenY property - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance properti