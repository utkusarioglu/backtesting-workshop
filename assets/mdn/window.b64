n icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<div class=\\\"notecard nonstandard\\\" id=\\\"sect1\\\"><p><strong>Non-standard:</strong> This feature is non-standard and is not on a standards track. Do not use it on production sites facing the Web: it will not work for every user. There may also be large incompatibilities between implementations and the behavior may change in the future.</p></div>\\n<p>\\n  The <strong><code>Window.scrollByPages()</code></strong> method scrolls the current\\n  document by the specified number of pages.\\n</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"syntax\",\"title\":\"Syntax\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"J/oBhQfCd00ER+7O0L3AZlcjkNYW1XC5tOlFj0su9Cc=\\\"><code><span class=\\\"token function\\\">scrollByPages</span><span class=\\\"token punctuation\\\">(</span>pages<span class=\\\"token punctuation\\\">)</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"parameters\",\"title\":\"Parameters\",\"isH3\":true,\"content\":\"<ul>\\n  <li>\\n    <code>pages</code> is the number of pages to scroll. It may be a positive or\\n    negative integer.\\n  </li>\\n</ul>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"return_value\",\"title\":\"Return value\",\"isH3\":true,\"content\":\"<p>None (<a href=\\\"/en-US/docs/Web/JavaScript/Reference/Global_Objects/undefined\\\"><code>undefined</code></a>).</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"+dMthBCmhkrv1jbdeVKyD9x1AYTHsz+muw1XsVHZYT8=\\\"><code><span class=\\\"token comment\\\">// scroll down the document by 1 page</span>\\nwindow<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">scrollByPages</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token number\\\">1</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n\\n<span class=\\\"token comment\\\">// scroll up the document by 1 page</span>\\nwindow<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">scrollByPages</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token operator\\\">-</span><span class=\\\"token number\\\">1</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"specifications\",\"title\":\"Specifications\",\"isH3\":false,\"content\":\"<p>DOM Level 0. Not part of specification.</p>\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.scrollByPages\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scroll\\\"><code>window.scroll()</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollBy\\\"><code>window.scrollBy()</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollByLines\\\"><code>window.scrollByLines()</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollTo\\\"><code>window.scrollTo()</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Syntax\",\"id\":\"syntax\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The Window.scrollByPages() method scrolls the current\\n  document by the specified number of pages.\",\"popularity\":0.0024,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"fr\",\"title\":\"Window.scrollByPages()\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"Window.scrollByPages()\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"pt-BR\",\"title\":\"Window.scrollByPages()\",\"native\":\"Portugu\u00c3\u00aas (do\u00c2\u00a0Brasil)\"},{\"locale\":\"zh-CN\",\"title\":\"window.scrollByPages\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/scrollbypages\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/scrollbypages/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"scrollByPages()\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/scrollByPages\",\"title\":\"scrollByPages()\"}],\"pageTitle\":\"Window: scrollByPages() method - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": 