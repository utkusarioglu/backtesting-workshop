blur_event\\\"><code>blur</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/copy_event\\\"><code>copy</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/cut_event\\\"><code>cut</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/devicemotion_event\\\"><code>devicemotion</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientation_event\\\"><code>deviceorientation</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientationabsolute_event\\\"><code>deviceorientationabsolute</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/error_event\\\"><code>error</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/focus_event\\\"><code>focus</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepadconnected_event\\\"><code>gamepadconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>moveBy()</code></strong> method of the <a href=\\\"/en-US/docs/Web/API/Window\\\"><code>Window</code></a>\\n  interface moves the current window by a specified amount.\\n</p>\\n<div class=\\\"notecard note\\\" id=\\\"sect1\\\">\\n  <p>\\n    <strong>Note:</strong> This function moves the window relative to its current\\n    location. In contrast, <a href=\\\"/en-US/docs/Web/API/Window/moveTo\\\"><code>window.moveTo()</code></a> moves the window to an absolute\\n    location.\\n  </p>\\n</div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"syntax\",\"title\":\"Syntax\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"EdNhjBFE5ch8x/7hL3l0Z5pJ+4VlAM+2tupRyU01gMA=\\\"><code><span class=\\\"token function\\\">moveBy</span><span class=\\\"token punctuation\\\">(</span>deltaX<span class=\\\"token punctuation\\\">,</span> deltaY<span class=\\\"token punctuation\\\">)</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"parameters\",\"title\":\"Parameters\",\"isH3\":true,\"content\":\"<ul>\\n  <li>\\n    <code>deltaX</code> is the amount of pixels to move the window horizontally.\\n    Positive values are to the right, while negative values are to the left.\\n  </li>\\n  <li>\\n    <code>deltaY</code> is the amount of pixels to move the window vertically. Positive\\n    values are down, while negative values are up.\\n  </li>\\n</ul>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"return_value\",\"title\":\"Return value\",\"isH3\":true,\"content\":\"<p>None (<a href=\\\"/en-US/docs/Web/JavaScript/Reference/Global_Objects/undefined\\\"><code>undefined</code></a>).</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<p>This example moves the window 10 pixels to the right and 10 pixels up.</p>\\n<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"9vmdAcsJUkA+nEAcubfF/8lYs1anNgKJrMpWbqUxccY=\\\"><code><span class=\\\"token keyword\\\">function</span> <span class=\\\"token function\\\">budge</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n  <span class=\\\"token function\\\">moveBy</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token number\\\">10</span><span class=\\\"token punctuation\\\">,</span> <span class=\\\"token operator\\\">-</span><span class=\\\"token number\\\">10</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n<span class=\\\"token punctuation\\\">}</span>\\n</code></pre></div>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://drafts.csswg.org/cssom-view/#dom-window-moveby\",\"title\":\"CSSOM View Module\"}],\"query\":\"api.Window.moveBy\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.moveBy\"}},{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>As of Firefox 7, websites can no longer move a browser window <a href=\\\"https://bugzil.la/565541#c24\\\" class=\\\"external\\\" target=\\\"_blank\\\">in the following cases</a>:</p>\\n<ol>\\n  <li>You can't move a window or tab that wasn't created by <a href=\\\"/en-US/docs/Web/API/Window/open\\\"><code>Window.open()</code></a>.</li>\\n  <li>You can't move a window or tab when it's in a window with more than one tab.</li>\\n</ol>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/moveTo\\\"><code>Window.moveTo()</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Syntax\",\"id\":\"syntax\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The moveBy() method of the Window\\n  interface moves the current window by a specified amount.\",\"popularity\":0.0017,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"es\",\"title\":\"Window.moveBy()\",\"native\":\"Espa\u00c3\u00b1ol\"},{\"locale\":\"ja\",\"title\":\"Window.moveBy()\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ru\",\"title\":\"Window.moveBy()\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"Window.moveBy()\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/moveby\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/moveby/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"moveBy()\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/moveBy\",\"title\":\"moveBy()\"}],\"pageTitle\":\"Window: moveBy() method - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance methods", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/moveTo", "link_title": "moveTo()", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.6803c6f0.png\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link rel=\"manifest\" href=\"/manifest.56b1cedc.json\"/><link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"/opensearch.xml\" title=\"MDN Web Docs\"/><title>Window: moveTo() method - Web APIs | MDN</title><link rel=\"alternate\" title=\"Window.mo