illa.org%2Fen-US%2Fdocs%2FWeb%2FAPI%2FWindow%2Fprompt%0A*+GitHub+URL%3A+https%3A%2F%2Fgithub.com%2Fmdn%2Fcontent%2Fblob%2Fmain%2Ffiles%2Fen-us%2Fweb%2Fapi%2Fwindow%2Fprompt%2Findex.md%0A*+Last+commit%3A+https%3A%2F%2Fgithub.com%2Fmdn%2Fcontent%2Fcommit%2Fcc070123f72376faec06e36622c4fc723a75325f%0A*+Document+last+modified%3A+2023-04-08T06%3A57%3A07.000Z%0A%0A%3C%2Fdetails%3E\" title=\"This will take you to GitHub to file a new issue.\" target=\"_blank\" rel=\"noopener noreferrer\">Report a problem with this content</a></div></div></aside></main></div></div><footer id=\"nav-footer\" class=\"page-footer\"><div class=\"page-footer-grid\"><div class=\"page-footer-logo-col\"><a href=\"/\" class=\"mdn-footer-logo\" aria-label=\"MDN homepage\"><svg width=\"48\" height=\"17\" viewBox=\"0 0 48 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><title id=\"mdn-footer-logo-svg\">MDN logo</title><path d=\"M20.04 16.512H15.504V10.416C15.504 9.488 15.344 8.824 15.024 8.424C14.72 8.024 14.264 7.824 13.656 7.824C12.92 7.824 12.384 8.064 12.048 8.544C11.728 9.024 11.568 9.64 11.568 10.392V14.184H13.008V16.512H8.472V10.416C8.472 9.488 8.312 8.824 7.992 8.424C7.688 8.024 7.232 7.824 6.624 7.824C5.872 7.824 5.336 8.064 5.016 8.544C4.696 9.024 4.536 9.64 4.536 10.392V14.184H6.6V16.512H0V14.184H1.44V8.04H0.024V5.688H4.536V7.32C5.224 6.088 6.32 5.472 7.824 5.472C8.608 5.472 9.328 5.664 9.984 6.048C10.64 6.432 11.096 7.016 11.352 7.8C11.992 6.248 13.168 5.472 14.88 5.472C15.856 5.472 16.72 5.776 17.472 6.384C18.224 6.992 18.6 7.936 18.6 9.216V14.184H20.04V16.512Z\" fill=\"currentColor\"></path><path d=\"M33.6714 16.512H29.1354V14.496C28.8314 15.12 28.3834 15.656 27.7914 16.104C27.1994 16.536 26.4154 16.752 25.4394 16.752C24.0154 16.752 22.8954 16.264 22.0794 15.288C21.2634 14.312 20.8554 12.984 20.8554 11.304C20.8554 9.688 21.2554 8.312 22.0554 7.176C22.8554 6.04 24.0634 5.472 25.6794 5.472C26.5594 5.472 27.2794 5.648 27.8394 6C28.3994 6.352 28.8314 6.8 29.1354 7.344V2.352H26.9754V0H32