/API/Window/error_event\\\"><code>error</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/focus_event\\\"><code>focus</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepadconnected_event\\\"><code>gamepadconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>Window.closed</code></strong> read-only property indicates whether\\n  the referenced window is closed or not.\\n</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"value\",\"title\":\"Value\",\"isH3\":false,\"content\":\"<p>A boolean value. Possible values:</p>\\n<ul>\\n  <li><code>true</code>: The window has been closed.</li>\\n  <li><code>false</code>: The window is open.</li>\\n</ul>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"\"}},{\"type\":\"prose\",\"value\":{\"id\":\"change_the_url_of_a_window_from_a_popup\",\"title\":\"Change the URL of a window from a popup\",\"isH3\":true,\"content\":\"<p>\\n  The following example demonstrates how a popup window can change the URL of the window\\n  that opened it. Before attempting to change the URL, it checks that the current window\\n  has an opener using the <a href=\\\"/en-US/docs/Web/API/Window/opener\\\"><code>window.opener</code></a> property and that the opener isn't\\n  closed:\\n</p>\\n<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"do71JNOaYKMvLWpT4qTptWrnPK7qMxANjKHGvhGSw/o=\\\"><code><span class=\\\"token comment\\\">// Check that an opener exists and is not closed</span>\\n<span class=\\\"token keyword\\\">if</span> <span class=\\\"token punctuation\\\">(</span>window<span class=\\\"token punctuation\\\">.</span>opener <span class=\\\"token operator\\\">&amp;&amp;</span> <span class=\\\"token operator\\\">!</span>window<span class=\\\"token punctuation\\\">.</span>opener<span class=\\\"token punctuation\\\">.</span>closed<span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n  window<span class=\\\"token punctuation\\\">.</span>opener<span class=\\\"token punctuation\\\">.</span>location<span class=\\\"token punctuation\\\">.</span>href <span class=\\\"token operator\\\">=</span> <span class=\\\"token string\\\">\\\"https://www.mozilla.org\\\"</span><span class=\\\"token punctuation\\\">;</span>\\n<span class=\\\"token punctuation\\\">}</span>\\n</code></pre></div>\\n<p>Note that popups can only access the window that opened them.</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"refreshing_a_previously_opened_popup\",\"title\":\"Refreshing a previously opened popup\",\"isH3\":true,\"content\":\"<p>\\n  In this example the function <code>refreshPopupWindow()</code> calls the\\n  <code>reload()</code> method of the popup's location object to refresh its data. If the\\n  popup hasn't been opened yet or the user has closed it a new window is opened.\\n</p>\\n<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"7TfcfigNmaIS7T9E1y7ILw+FcpO3Px0IFxzljh58yek=\\\"><code><span class=\\\"token keyword\\\">let</span> popupWindow <span class=\\\"token operator\\\">=</span> <span class=\\\"token keyword\\\">null</span><span class=\\\"token punctuation\\\">;</span>\\n\\n<span class=\\\"token keyword\\\">function</span> <span class=\\\"token function\\\">refreshPopupWindow</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n  <span class=\\\"token keyword\\\">if</span> <span class=\\\"token punctuation\\\">(</span>popupWindow <span class=\\\"token operator\\\">&amp;&amp;</span> <span class=\\\"token operator\\\">!</span>popupWindow<span class=\\\"token punctuation\\\">.</span>closed<span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n    <span class=\\\"token comment\\\">// popupWindow is open, refresh it</span>\\n    popupWindow<span class=\\\"token punctuation\\\">.</span>location<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">reload</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token boolean\\\">true</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n  <span class=\\\"token punctuation\\\">}</span> <span class=\\\"token keyword\\\">else</span> <span class=\\\"token punctuation\\\">{</span>\\n    <span class=\\\"token comment\\\">// Open a new popup window</span>\\n    popupWindow <span class=\\\"token operator\\\">=</span> window<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">open</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token string\\\">\\\"popup.html\\\"</span><span class=\\\"token punctuation\\\">,</span> <span class=\\\"token string\\\">\\\"dataWindow\\\"</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n  <span class=\\\"token punctuation\\\">}</span>\\n<span class=\\\"token punctuation\\\">}</span>\\n</code></pre></div>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://html.spec.whatwg.org/multipage/window-object.html#dom-window-closed-dev\",\"title\":\"HTML Standard\"}],\"query\":\"api.Window.closed\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.closed\"}}],\"toc\":[{\"text\":\"Value\",\"id\":\"value\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"}],\"summary\":\"The Window.closed read-only property indicates whether\\n  the referenced window is closed or not.\",\"popularity\":0.004,\"modified\":\"2024-05-06T09:17:40.000Z\",\"other_translations\":[{\"locale\":\"es\",\"title\":\"Window.closed\",\"native\":\"Espa\u00c3\u00b1ol\"},{\"locale\":\"fr\",\"title\":\"window.closed\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"window.closed\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ko\",\"title\":\"Window.closed\",\"native\":\"\u00ed\u0095\u009c\u00ea\u00b5\u00ad\u00ec\u0096\u00b4\"},{\"locale\":\"pt-BR\",\"title\":\"Window.closed\",\"native\":\"Portugu\u00c3\u00aas (do\u00c2\u00a0Brasil)\"},{\"locale\":\"ru\",\"title\":\"Window.closed\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"Window.closed\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/closed\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/closed/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/94ef07a7b073c2663cbace0667bdb717a40bfa28\",\"filename\":\"index.md\"},\"short_title\":\"closed\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/closed\",\"title\":\"closed\"}],\"pageTitle\":\"Window: closed property - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance properties", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/console", "link_title": "console", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.6803c6f0.png\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link rel=\"manifest\" href=\"/manifest.56b1cedc.json\"/><link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"/opensearch.xml\" title=\"MDN Web Docs\"/><title>Window: console property - Web APIs | MDN</title><link rel=\"alternate\" title=\"Window: Propiedad console\" href=\"https://developer.mozilla.org/es/docs/Web/API/Window/console\" hreflang=\"es\"/><link rel=\"alternate\" title=\"Window.console\" href=\"https://developer.mozilla.org/fr/docs/Web/API/Window/console\" hreflang=\"fr\"/><link rel=\"alternate\" title=\"Window.console\" href=\"https://developer.mozilla.org/ja/docs/Web/API/Window/console\" hreflang=\"ja\"/><link rel=\"alternate\" title=\"Window.console\" href=\"https://developer.mozilla.org/ko/docs/Web/API/Window/console\" hreflang=\"ko\"/><link rel=\"alternate\" title=\"Window.console\" href=\"https://developer.mozilla.org/ru/docs/Web/API/Window/console\" hreflang=\"ru\"/><link rel=\"alternate\" title=\"Window\u00ef\u00bc\u009aconsole \u00e5\u00b1\u009e\u00e6\u0080\u00a7\" href=\"https://developer.mozilla.org/zh-CN/docs/Web/API/Window/console\" hreflang=\"zh\"/><link rel=\"alternate\" title=\"Window: console property\" href=\"https://developer.mo