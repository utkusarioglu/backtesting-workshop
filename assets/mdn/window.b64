>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>window.stop()</code></strong> stops further resource loading in the current\\n  browsing context, equivalent to the stop button in the browser.\\n</p>\\n<p>\\n  Because of how scripts are executed, this method cannot interrupt its parent\\n  document's loading, but it will stop its images, new windows, and other still-loading\\n  objects.\\n</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"syntax\",\"title\":\"Syntax\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"yYpoFNP9kCbLh/pqXIz4JeP+tdcC9j9kqttDlKhy9uU=\\\"><code><span class=\\\"token function\\\">stop</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">)</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"parameters\",\"title\":\"Parameters\",\"isH3\":true,\"content\":\"<p>None.</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"return_value\",\"title\":\"Return value\",\"isH3\":true,\"content\":\"<p>None (<a href=\\\"/en-US/docs/Web/JavaScript/Reference/Global_Objects/undefined\\\"><code>undefined</code></a>).</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"vsTpRSEx/fjtV7jgRI9tnNhskuRXdxJRrbV6F40zinw=\\\"><code>window<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">stop</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n</code></pre></div>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://html.spec.whatwg.org/multipage/window-object.html#dom-window-stop-dev\",\"title\":\"HTML Standard\"}],\"query\":\"api.Window.stop\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.stop\"}}],\"toc\":[{\"text\":\"Syntax\",\"id\":\"syntax\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"}],\"summary\":\"The window.stop() stops further resource loading in the current\\n  browsing context, equivalent to the stop button in the browser.\",\"popularity\":0.0037,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"fr\",\"title\":\"Window.stop()\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"window.stop\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ko\",\"title\":\"Window.stop()\",\"native\":\"\u00ed\u0095\u009c\u00ea\u00b5\u00ad\u00ec\u0096\u00b4\"},{\"locale\":\"ru\",\"title\":\"Window.stop()\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"Window.stop()\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/stop\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/a