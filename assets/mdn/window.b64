b/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>Returns the <code>personalbar</code> object.</p>\\n<p>This is one of a group of <code>Window</code> properties that contain a boolean <code>visible</code> property, that used to represent whether or not a particular part of a web browser's user interface was visible.</p>\\n<p>For privacy and interoperability reasons, the value of the <code>visible</code> property is now <code>false</code> if this <code>Window</code> is a popup, and <code>true</code> otherwise.</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"value\",\"title\":\"Value\",\"isH3\":false,\"content\":\"<p>An object containing a single property:</p>\\n<dl>\\n  <dt id=\\\"visible\\\"><a href=\\\"#visible\\\"><code>visible</code></a> <span title=\\\"This value may not be changed.\\\" class=\\\"badge inline readonly\\\">Read only </span></dt>\\n  <dd>\\n    <p>A boolean property, <code>false</code> if this <code>Window</code> is a popup, and <code>true</code> otherwise.</p>\\n  </dd>\\n</dl>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://html.spec.whatwg.org/multipage/window-object.html#dom-window-personalbar-dev\",\"title\":\"HTML Standard\"}],\"query\":\"api.Window.personalbar\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.personalbar\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/locationbar\\\"><code>window.locationbar</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/menubar\\\"><code>window.menubar</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollbars\\\"><code>window.scrollbars</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/statusbar\\\"><code>window.statusbar</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/toolbar\\\"><code>window.toolbar</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Value\",\"id\":\"value\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"Returns the personalbar object.\",\"popularity\":0.0008,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"ja\",\"title\":\"Window: personalbar \u00e3\u0083\u0097\u00e3\u0083\u00ad\u00e3\u0083\u0091\u00e3\u0083\u0086\u00e3\u0082\u00a3\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"}],\"source\":{\"folder\":\"en-us/web/api/window/personalbar\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/personalbar/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"personalbar\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/personalbar\",\"title\":\"personalbar\"}],\"pageTitle\":\"Window: personalbar property - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance properties", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/scheduler", "link_title": "scheduler", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png