S/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>Window.parent</code></strong> property is a reference to the parent\\n  of the current window or subframe.\\n</p>\\n<p>\\n  If a window does not have a parent, its <code>parent</code> property is a reference to\\n  itself.\\n</p>\\n<p>\\n  When a window is loaded in an <a href=\\\"/en-US/docs/Web/HTML/Element/iframe\\\"><code>&lt;iframe&gt;</code></a>, <a href=\\\"/en-US/docs/Web/HTML/Element/object\\\"><code>&lt;object&gt;</code></a>, or\\n  <a href=\\\"/en-US/docs/Web/HTML/Element/frame\\\"><code>&lt;frame&gt;</code></a>, its parent is the window with the element embedding the\\n  window.\\n</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"value\",\"title\":\"Value\",\"isH3\":false,\"content\":\"<p>A <code>Window</code> or <a href=\\\"/en-US/docs/Web/HTML/Element/iframe\\\"><code>&lt;iframe&gt;</code></a> object.</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"KXh1EUH+j+QlKyu4N5oT+Tc5VG2MGNxAhpBOuu154dU=\\\"><code><span class=\\\"token keyword\\\">if</span> <span class=\\\"token punctuation\\\">(</span>window<span class=\\\"token punctuation\\\">.</span>parent <span class=\\\"token operator\\\">!==</span> window<span class=\\\"token punctuation\\\">.</span>top<span class=\\\"token punctuation\\\">)</span> <span class=\\\"token punctuation\\\">{</span>\\n  <span class=\\\"token comment\\\">// We're deeper than one down</span>\\n<span class=\\\"token punctuation\\\">}</span>\\n</code></pre></div>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-parent-dev\",\"title\":\"HTML Standard\"}],\"query\":\"api.Window.parent\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.parent\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li>\\n    <a href=\\\"/en-US/docs/Web/API/Window/frameElement\\\"><code>window.frameElement</code></a> returns the specific element (such as\\n    <code>&lt;iframe&gt;</code>) the <code>window</code> is embedded into.\\n  </li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/top\\\"><code>window.top</code></a> returns a reference to the top-level window.</li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Value\",\"id\":\"value\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The Window.parent property is a reference to the parent\\n  of the current window or subframe.\",\"popularity\":0.0094,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"fr\",\"title\":\"Window.parent\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"window.parent\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ru\",\"title\":\"Window.parent\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"window.parent\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/parent\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/parent/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"parent\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/parent\",\"title\":\"parent\"}],\"pageTitle\":\"Window: parent property - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance properties", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/performance", "link_title": "performance", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.6803c6f0.png\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link rel=\"manifest\" href=\"/manifest.56b1cedc.json\"/><link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"/opensearch.xml\" title=\"MDN Web Docs\"/><title>Window: performance property - Web APIs | MDN</title><link rel=\"alternate\" title=\"Window.performance\" href=\"https://developer.mozilla.org/ja/docs/Web/API/Window/performance\" hreflang=\"ja\"/><link rel=\"alternate\" title=\"Window.performance\" href=\"https://developer.mozilla.org/pt-BR/docs/Web/API/Window/performance\" hreflang=\"pt\"/><link rel=\"alternate