/Web/API/Window/afterprint_event\\\"><code>afterprint</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/appinstalled_event\\\"><code>appinstalled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/beforeinstallprompt_event\\\"><code>beforeinstallprompt</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/beforeprint_event\\\"><code>beforeprint</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/beforeunload_event\\\"><code>beforeunload</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/blur_event\\\"><code>blur</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/copy_event\\\"><code>copy</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/cut_event\\\"><code>cut</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/devicemotion_event\\\"><code>devicemotion</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientation_event\\\"><code>deviceorientation</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/deviceorientationabsolute_event\\\"><code>deviceorientationabsolute</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/error_event\\\"><code>error</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/focus_event\\\"><code>focus</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepadconnected_event\\\"><code>gamepadconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/gamepaddisconnected_event\\\"><code>gamepaddisconnected</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/hashchange_event\\\"><code>hashchange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/languagechange_event\\\"><code>languagechange</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/load_event\\\"><code>load</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/message_event\\\"><code>message</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/messageerror_event\\\"><code>messageerror</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/offline_event\\\"><code>offline</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/online_event\\\"><code>online</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/orientationchange_event\\\"><code>orientationchange</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/pagehide_event\\\"><code>pagehide</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/pageshow_event\\\"><code>pageshow</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/paste_event\\\"><code>paste</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/popstate_event\\\"><code>popstate</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/rejectionhandled_event\\\"><code>rejectionhandled</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/resize_event\\\"><code>resize</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/storage_event\\\"><code>storage</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unhandledrejection_event\\\"><code>unhandledrejection</code></a></li><li><a href=\\\"/en-US/docs/Web/API/Window/unload_event\\\"><code>unload</code></a><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayactivate_event\\\"><code>vrdisplayactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplayconnect_event\\\"><code>vrdisplayconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydeactivate_event\\\"><code>vrdisplaydeactivate</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaydisconnect_event\\\"><code>vrdisplaydisconnect</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li><li><a href=\\\"/en-US/docs/Web/API/Window/vrdisplaypresentchange_event\\\"><code>vrdisplaypresentchange</code></a><abbr class=\\\"icon icon-nonstandard\\\" title=\\\"Non-standard. Check cross-browser support before using.\\\">\\n    <span class=\\\"visually-hidden\\\">Non-standard</span>\\n</abbr><abbr class=\\\"icon icon-deprecated\\\" title=\\\"Deprecated. Not for use in new websites.\\\">\\n  <span class=\\\"visually-hidden\\\">Deprecated</span>\\n</abbr></li></ol></details></li><li class=\\\"toggle\\\"><details open=\\\"\\\"><summary>Inheritance</summary><ol><li><a href=\\\"/en-US/docs/Web/API/EventTarget\\\"><code>EventTarget</code></a></li></ol></details></li></ol>\",\"sidebarMacro\":\"APIRef\",\"body\":[{\"type\":\"prose\",\"value\":{\"id\":null,\"title\":null,\"isH3\":false,\"content\":\"<p>\\n  The <strong><code>Window.scroll()</code></strong> method scrolls the window to a\\n  particular place in the document.\\n</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"syntax\",\"title\":\"Syntax\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"P40ZumYMrYTrfSQ4OVDJTQdXVJ+NdZZ71r/Y2MDKxqA=\\\"><code><span class=\\\"token function\\\">scroll</span><span class=\\\"token punctuation\\\">(</span>x<span class=\\\"token operator\\\">-</span>coord<span class=\\\"token punctuation\\\">,</span> y<span class=\\\"token operator\\\">-</span>coord<span class=\\\"token punctuation\\\">)</span>\\n<span class=\\\"token function\\\">scroll</span><span class=\\\"token punctuation\\\">(</span>options<span class=\\\"token punctuation\\\">)</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"parameters\",\"title\":\"Parameters\",\"isH3\":true,\"content\":\"<ul>\\n  <li>\\n    <code>x-coord</code> is the pixel along the horizontal axis of the document that you\\n    want displayed in the upper left.\\n  </li>\\n  <li>\\n    <code>y-coord</code> is the pixel along the vertical axis of the document that you\\n    want displayed in the upper left.\\n  </li>\\n</ul>\\n<p>- or -</p>\\n<dl>\\n  <dt id=\\\"options\\\"><a href=\\\"#options\\\"><code>options</code></a></dt>\\n  <dd>\\n    <p>A dictionary containing the following parameters:</p>\\n    <dl>\\n      <dt id=\\\"top\\\"><a href=\\\"#top\\\"><code>top</code></a></dt>\\n      <dd>\\n        <p>Specifies the number of pixels along the Y axis to scroll the window or element.</p>\\n      </dd>\\n      <dt id=\\\"left\\\"><a href=\\\"#left\\\"><code>left</code></a></dt>\\n      <dd>\\n        <p>Specifies the number of pixels along the X axis to scroll the window or element.</p>\\n      </dd>\\n      <dt id=\\\"behavior\\\"><a href=\\\"#behavior\\\"><code>behavior</code></a></dt>\\n      <dd>\\n        <p>Determines whether scrolling is instant or animates smoothly. This option is a string which must take one of the following values:</p>\\n        <ul>\\n          <li><code>smooth</code>: scrolling should animate smoothly</li>\\n          <li><code>instant</code>: scrolling should happen instantly in a single jump</li>\\n          <li><code>auto</code>: scroll behavior is determined by the computed value of <a href=\\\"/en-US/docs/Web/CSS/scroll-behavior\\\"><code>scroll-behavior</code></a></li>\\n        </ul>\\n      </dd>\\n    </dl>\\n  </dd>\\n</dl>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"return_value\",\"title\":\"Return value\",\"isH3\":true,\"content\":\"<p>None (<a href=\\\"/en-US/docs/Web/JavaScript/Reference/Global_Objects/undefined\\\"><code>undefined</code></a>).</p>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"examples\",\"title\":\"Examples\",\"isH3\":false,\"content\":\"<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">html</span></div><pre class=\\\"brush: html notranslate\\\" data-signature=\\\"ZLBP8WOukkb2OHvRKQcdukeJFXhdLWZQykE6m6NVV3U=\\\"><code><span class=\\\"token comment\\\">&lt;!-- put the 100th vertical pixel at the top of the window --&gt;</span>\\n\\n<span class=\\\"token tag\\\"><span class=\\\"token tag\\\"><span class=\\\"token punctuation\\\">&lt;</span>button</span> <span class=\\\"token special-attr\\\"><span class=\\\"token attr-name\\\">onclick</span><span class=\\\"token attr-value\\\"><span class=\\\"token punctuation attr-equals\\\">=</span><span class=\\\"token punctuation\\\">\\\"</span><span class=\\\"token value javascript language-javascript\\\"><span class=\\\"token function\\\">scroll</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token number\\\">0</span><span class=\\\"token punctuation\\\">,</span> <span class=\\\"token number\\\">100</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span></span><span class=\\\"token punctuation\\\">\\\"</span></span></span><span class=\\\"token punctuation\\\">&gt;</span></span>click to scroll to the 100th pixel<span class=\\\"token tag\\\"><span class=\\\"token tag\\\"><span class=\\\"token punctuation\\\">&lt;/</span>button</span><span class=\\\"token punctuation\\\">&gt;</span></span>\\n</code></pre></div>\\n<p>Using <code>options</code>:</p>\\n<div class=\\\"code-example\\\"><div class=\\\"example-header\\\"><span class=\\\"language-name\\\">js</span></div><pre class=\\\"brush: js notranslate\\\" data-signature=\\\"StEbS3rBd2seUpK/ZaQxenT6EalhumbkIXHRbT3BgTI=\\\"><code>window<span class=\\\"token punctuation\\\">.</span><span class=\\\"token function\\\">scroll</span><span class=\\\"token punctuation\\\">(</span><span class=\\\"token punctuation\\\">{</span>\\n  <span class=\\\"token literal-property property\\\">top</span><span class=\\\"token operator\\\">:</span> <span class=\\\"token number\\\">100</span><span class=\\\"token punctuation\\\">,</span>\\n  <span class=\\\"token literal-property property\\\">left</span><span class=\\\"token operator\\\">:</span> <span class=\\\"token number\\\">100</span><span class=\\\"token punctuation\\\">,</span>\\n  <span class=\\\"token literal-property property\\\">behavior</span><span class=\\\"token operator\\\">:</span> <span class=\\\"token string\\\">\\\"smooth\\\"</span><span class=\\\"token punctuation\\\">,</span>\\n<span class=\\\"token punctuation\\\">}</span><span class=\\\"token punctuation\\\">)</span><span class=\\\"token punctuation\\\">;</span>\\n</code></pre></div>\"}},{\"type\":\"prose\",\"value\":{\"id\":\"notes\",\"title\":\"Notes\",\"isH3\":false,\"content\":\"<p>\\n  <a href=\\\"/en-US/docs/Web/API/Window/scrollTo\\\"><code>Window.scrollTo()</code></a> is effectively the same as this method. For relative\\n  scrolling, see <a href=\\\"/en-US/docs/Web/API/Window/scrollBy\\\"><code>Window.scrollBy()</code></a>, <a href=\\\"/en-US/docs/Web/API/Window/scrollByLines\\\"><code>Window.scrollByLines()</code></a>,\\n  and <a href=\\\"/en-US/docs/Web/API/Window/scrollByPages\\\"><code>Window.scrollByPages()</code></a>.\\n</p>\\n<p>\\n  For scrolling elements, see <a href=\\\"/en-US/docs/Web/API/Element/scrollTop\\\"><code>Element.scrollTop</code></a> and\\n  <a href=\\\"/en-US/docs/Web/API/Element/scrollLeft\\\"><code>Element.scrollLeft</code></a>.\\n</p>\"}},{\"type\":\"specifications\",\"value\":{\"title\":\"Specifications\",\"id\":\"specifications\",\"isH3\":false,\"specifications\":[{\"bcdSpecificationURL\":\"https://drafts.csswg.org/cssom-view/#dom-window-scroll\",\"title\":\"CSSOM View Module\"}],\"query\":\"api.Window.scroll\"}},{\"type\":\"browser_compatibility\",\"value\":{\"title\":\"Browser compatibility\",\"id\":\"browser_compatibility\",\"isH3\":false,\"query\":\"api.Window.scroll\"}},{\"type\":\"prose\",\"value\":{\"id\":\"see_also\",\"title\":\"See also\",\"isH3\":false,\"content\":\"<ul>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollByLines\\\"><code>Window.scrollByLines()</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Window/scrollByPages\\\"><code>Window.scrollByPages()</code></a></li>\\n  <li><a href=\\\"/en-US/docs/Web/API/Element/scrollIntoView\\\"><code>Element.scrollIntoView()</code></a></li>\\n</ul>\"}}],\"toc\":[{\"text\":\"Syntax\",\"id\":\"syntax\"},{\"text\":\"Examples\",\"id\":\"examples\"},{\"text\":\"Notes\",\"id\":\"notes\"},{\"text\":\"Specifications\",\"id\":\"specifications\"},{\"text\":\"Browser compatibility\",\"id\":\"browser_compatibility\"},{\"text\":\"See also\",\"id\":\"see_also\"}],\"summary\":\"The Window.scroll() method scrolls the window to a\\n  particular place in the document.\",\"popularity\":0.033,\"modified\":\"2023-04-08T06:57:07.000Z\",\"other_translations\":[{\"locale\":\"es\",\"title\":\"Window.scroll()\",\"native\":\"Espa\u00c3\u00b1ol\"},{\"locale\":\"fr\",\"title\":\"Window.scroll()\",\"native\":\"Fran\u00c3\u00a7ais\"},{\"locale\":\"ja\",\"title\":\"window.scroll\",\"native\":\"\u00e6\u0097\u00a5\u00e6\u009c\u00ac\u00e8\u00aa\u009e\"},{\"locale\":\"ko\",\"title\":\"Window.scroll()\",\"native\":\"\u00ed\u0095\u009c\u00ea\u00b5\u00ad\u00ec\u0096\u00b4\"},{\"locale\":\"pt-BR\",\"title\":\"Window: m\u00c3\u00a9todo scroll()\",\"native\":\"Portugu\u00c3\u00aas (do\u00c2\u00a0Brasil)\"},{\"locale\":\"ru\",\"title\":\"Window.scroll()\",\"native\":\"\u00d0\u00a0\u00d1\u0083\u00d1\u0081\u00d1\u0081\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9\"},{\"locale\":\"zh-CN\",\"title\":\"Window.scroll()\",\"native\":\"\u00e4\u00b8\u00ad\u00e6\u0096\u0087 (\u00e7\u00ae\u0080\u00e4\u00bd\u0093)\"}],\"source\":{\"folder\":\"en-us/web/api/window/scroll\",\"github_url\":\"https://github.com/mdn/content/blob/main/files/en-us/web/api/window/scroll/index.md\",\"last_commit_url\":\"https://github.com/mdn/content/commit/cc070123f72376faec06e36622c4fc723a75325f\",\"filename\":\"index.md\"},\"short_title\":\"scroll()\",\"parents\":[{\"uri\":\"/en-US/docs/Web\",\"title\":\"References\"},{\"uri\":\"/en-US/docs/Web/API\",\"title\":\"Web APIs\"},{\"uri\":\"/en-US/docs/Web/API/Window\",\"title\":\"Window\"},{\"uri\":\"/en-US/docs/Web/API/Window/scroll\",\"title\":\"scroll()\"}],\"pageTitle\":\"Window: scroll() method - Web APIs | MDN\",\"noIndexing\":false}}</script></body></html>"}, {"section_name": "Instance methods", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Window/scrollBy", "link_title": "scrollBy()", "html": "<!doctype html><html lang=\"en-US\" prefix=\"og: https://ogp.me/ns#\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><link rel=\"icon\" href=\"/favicon-48x48.cbbd161b.png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.6803c6f0.png\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link rel=\"manifest\" href=\"/manifest.56b1cedc.json\"/><link rel=\"search\" type=\"application/o