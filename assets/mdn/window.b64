cancelIdleCallback\"><code>cancelIdleCallback()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/captureEvents\"><code>captureEvents()</code></a><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/clearImmediate\"><code>clearImmediate()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/close\"><code>close()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/confirm\"><code>confirm()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/dump\"><code>dump()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/find\"><code>find()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/focus\"><code>focus()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/forward\"><code>forward()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/getComputedStyle\"><code>getComputedStyle()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/getDefaultComputedStyle\"><code>getDefaultComputedStyle()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/getScreenDetails\"><code>getScreenDetails()</code></a><abbr class=\"icon icon-experimental\" title=\"Experimental. Expect behavior to change in the future.\">\n    <span class=\"visually-hidden\">Experimental</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/getSelection\"><code>getSelection()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/matchMedia\"><code>matchMedia()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/moveBy\"><code>moveBy()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/moveTo\"><code>moveTo()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/open\"><code>open()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/postMessage\"><code>postMessage()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/print\"><code>print()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/prompt\"><code>prompt()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/queryLocalFonts\"><code>queryLocalFonts()</code></a><abbr class=\"icon icon-experimental\" title=\"Experimental. Expect behavior to change in the future.\">\n    <span class=\"visually-hidden\">Experimental</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/releaseEvents\"><code>releaseEvents()</code></a><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/requestAnimationFrame\"><code>requestAnimationFrame()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/requestFileSystem\"><code>requestFileSystem()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/requestIdleCallback\"><code>requestIdleCallback()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/resizeBy\"><code>resizeBy()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/resizeTo\"><code>resizeTo()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/scroll\"><code>scroll()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/scrollBy\"><code>scrollBy()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/scrollByLines\"><code>scrollByLines()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/scrollByPages\"><code>scrollByPages()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/scrollTo\"><code>scrollTo()</code></a></li><li><a href=\"/en-US/docs/Web/API/Window/setImmediate\"><code>setImmediate()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for use in new websites.\">\n  <span class=\"visually-hidden\">Deprecated</span>\n</abbr></li><li><a href=\"/en-US/docs/Web/API/Window/setResizable\"><code>setResizable()</code></a><abbr class=\"icon icon-nonstandard\" title=\"Non-standard. Check cross-browser support before using.\">\n    <span class=\"visually-hidden\">Non-standard</span>\n</abbr><abbr class=\"icon icon-deprecated\" title=\"Deprecated. Not for